# Copy this file to .env.local and fill it in. .env.local is never committed.

# Shift codes for the staff screens while there is no backend. They ship to
# the browser, so they are a deterrent, not authentication. Change them.
NEXT_PUBLIC_ADMIN_PIN=2580
NEXT_PUBLIC_DRIVER_PIN=1111

# The address the site answers on. Link previews need it absolute.
NEXT_PUBLIC_SITE_URL=https://flexchicken.uk
